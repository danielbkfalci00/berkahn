filters:
  and:
    - file.inFolder("40-content/blog")
    - 'tipo == "draft-content"'

formulas:
  seo_desc_len: 'if(seo_description, seo_description.length, 0)'
  seo_ok: 'if(seo_title && seo_desc_len >= 150, "OK", "FALTA")'

properties:
  titulo:
    displayName: "Título"
  publicado_em:
    displayName: "Publicado"
  palavras_chave:
    displayName: "Keywords"
  supabase_id:
    displayName: "Supabase ID"
  formula.seo_ok:
    displayName: "SEO"

views:
  - type: table
    name: "Publicados"
    filters:
      and:
        - 'status == "published"'
    order:
      - titulo
      - publicado_em
      - palavras_chave
      - supabase_id
    sort:
      - property: publicado_em
        direction: DESC

  - type: table
    name: "Drafts"
    filters:
      and:
        - 'status == "draft"'
    order:
      - titulo
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC

  - type: table
    name: "SEO incompleto"
    filters:
      or:
        - '!seo_title'
        - 'formula.seo_desc_len < 150'
    order:
      - titulo
      - formula.seo_ok
      - formula.seo_desc_len

  - type: table
    name: "Sem ai_summary (vault SKIM quebrado)"
    filters:
      or:
        - '!ai_summary'
        - 'ai_summary == ""'
    order:
      - titulo
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC

  - type: table
    name: "Sem answer_summary (AEO bloqueado)"
    filters:
      or:
        - '!answer_summary'
        - 'answer_summary == ""'
    order:
      - titulo
      - seo_title
    sort:
      - property: titulo
        direction: ASC

  - type: table
    name: "Sem material_visual_slug (capa)"
    filters:
      or:
        - '!material_visual_slug'
        - 'material_visual_slug == ""'
    order:
      - titulo
      - slug
    sort:
      - property: titulo
        direction: ASC

  - type: table
    name: "Por domínio"
    groupBy:
      property: tags
      direction: ASC
    order:
      - titulo
      - slug
      - publicado_em
