{
  "ruleConfigs": {
    "yaml-key-sort": {
      "enabled": true,
      "yaml-key-priority-sort-order": "tipo\ncriado\natualizado\ntags\nai_summary\nstatus\nsubtipo\nlocked\nslug\nversao\ncalibrado_em\npublicado_em\nseo_title\nseo_description\npalavras_chave\nsupabase_id\nurl_final",
      "priority-keys-at-start-of-yaml": true,
      "yaml-sort-order-for-other-keys": "None",
      "yaml-key-sort-alphabetically-desc": false
    },
    "yaml-timestamp": {
      "enabled": true,
      "date-created": true,
      "date-created-key": "criado",
      "date-modified": true,
      "date-modified-key": "atualizado",
      "format": "YYYY-MM-DD",
      "force-retention-of-create-value": false,
      "date-modified-source-of-truth-update-on-file-modification-only": true
    },
    "format-yaml-array": {
      "enabled": true,
      "format-yaml-array-section-style": "multi-line",
      "format-yaml-tags-section-style": "multi-line",
      "default-array-style": "multi-line"
    },
    "format-tags-in-yaml": {
      "enabled": true
    },
    "escape-yaml-special-characters": {
      "enabled": true,
      "try-to-escape-single-line-arrays": true
    },
    "yaml-title": {
      "enabled": false
    },
    "header-increment": {
      "enabled": true
    },
    "file-name-heading": {
      "enabled": true
    },
    "capitalize-headings": {
      "enabled": false
    },
    "remove-yaml-keys": {
      "enabled": false
    }
  }
}
