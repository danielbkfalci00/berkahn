# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-*.log
build-*.log

# debug screenshots (generated by Playwright/dev testing)
article-*.png
cta-*.png
faq-*.png
faq-*.jpg
comparison-*.png
hero-*.png
home-*.png
mobile-*.png
desktop-*.png
orcamento-*.png
screenshot-*.png
.dev_pid

# local env files (NEVER commit credentials)
.env
.env.local
.env*.local
*.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code settings (contains sensitive tokens)
.claude/settings.local.json
.claude/settings.local.json.backup
.claude/*.backup
.playwright-mcp/

# secrets (defensive — should never appear)
**/secrets.md
**/*.secret
**/credentials.json
gitleaks-*.json
tmpgitleaks*.json

# imagens otimizadas geradas (artefato de script)
/public/.optimized/
/secrets/
!/secrets/.gitkeep

# scripts (migration and utility scripts, not needed in production)
/scripts/
!/scripts/
/scripts/*
!/scripts/VAULT-SCRIPTS-README.md
!/scripts/conteudo/
/scripts/conteudo/*
!/scripts/conteudo/pauta.mjs
!/scripts/db/
/scripts/db/*
!/scripts/db/testar-autosave.mjs
!/scripts/db/testar-ordem.mjs
!/scripts/db/testar-estados.mjs
!/scripts/db/verificar-012.mjs

# Transcripts de sessao do Claude Code. Contem output de comandos, e por isso
# ja carregaram service key do Supabase e token assinado de PDF em texto claro.
# Nunca versionar: um `git add -A` distraido vaza credencial de producao.
.claude/sessions/
.agents/

# Harness de verificacao local. Renderiza telas do /admin sem sessao, lendo com
# a service key — precisa existir em disco para eu verificar UI que exige login,
# e NAO pode ir para producao (bypassa RLS e expoe rota publica).
# Ignorado desde a criacao, para nao depender de lembrar de apagar.
/app/dev-harness/
