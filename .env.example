# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Get these from your Supabase project settings:
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Monthly analytics job (local files or equivalent GitHub Actions secrets)
GA4_PROPERTY_ID=your-ga4-property-id
GSC_SITE_URL=sc-domain:example.com
GOOGLE_AUTH_MODE=oauth
# GOOGLE_OAUTH_CLIENT_JSON={"installed":{"client_id":"..."}}
# GOOGLE_OAUTH_TOKENS_JSON={"refresh_token":"..."}

# ===========================================
# GITHUB (scripts that push)
# ===========================================

GITHUB_PAT=your-personal-access-token

# ===========================================
# ADMIN PWA / WEB PUSH
# ===========================================
# Gere o par com `npx web-push generate-vapid-keys`. A chave privada e o
# segredo do cron são server-side; somente a chave pública usa NEXT_PUBLIC_.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:contato@berkahn.com.br
LEAD_PUSH_CRON_SECRET=generate-a-random-server-side-secret

# ===========================================
# SITE CONFIGURATION
# ===========================================

NEXT_PUBLIC_SITE_URL=https://berkahn.com.br
NEXT_PUBLIC_ADMIN_URL=https://admin.berkahn.com.br

# ===========================================
# N8N WEBHOOK INTEGRATION (Optional)
# ===========================================

N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/
N8N_REBUILD_WEBHOOK=https://your-n8n-instance.com/webhook/rebuild

# ===========================================
# VERCEL DEPLOY HOOK (Optional)
# ===========================================
# Used to trigger site rebuild when posts are published

VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# ===========================================
# PUPPETEER LOCAL (Dev only)
# ===========================================
# Path para Chrome local em desenvolvimento. Sem isso, @sparticuz/chromium tenta usar
# o binário serverless e falha em `npm run dev`. Usado por lib/puppeteer-launch.ts.
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux:   /usr/bin/google-chrome

CHROME_LOCAL_PATH=
